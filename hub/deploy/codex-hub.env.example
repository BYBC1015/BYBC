# Keep the real file at /etc/codex-hub.env, owned by root and mode 600.
# Never commit real credentials or paste them into a Hub project message.

CODEX_HUB_SERVER_AI_ENABLED=1

# DeepSeek direct API
# CODEX_HUB_DEEPSEEK_API_KEY=replace-through-a-secure-channel
CODEX_HUB_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
CODEX_HUB_DEEPSEEK_MODEL=deepseek-v4-pro

# Kimi Coding Plan direct API (membership keys with the sk-kimi- prefix)
# CODEX_HUB_KIMI_API_KEY=replace-through-a-secure-channel
CODEX_HUB_KIMI_BASE_URL=https://api.kimi.com/coding/v1
CODEX_HUB_KIMI_MODEL=k3

# Moonshot Platform API keys use https://api.moonshot.cn/v1 and model kimi-k3
# instead. Keep the endpoint, credential type, and model family paired.

# Resource and cost boundaries
CODEX_HUB_SERVER_AI_POLL_SECONDS=2
CODEX_HUB_SERVER_AI_REQUEST_TIMEOUT_SECONDS=90
CODEX_HUB_SERVER_AI_MAX_ATTEMPTS=3
CODEX_HUB_SERVER_AI_HISTORY_ENTRIES=20
CODEX_HUB_SERVER_AI_MAX_CONTEXT_CHARS=30000
CODEX_HUB_SERVER_AI_MAX_OUTPUT_TOKENS=4000
CODEX_HUB_SERVER_AI_MAX_REQUESTS_PER_DAY=100

# Keep this off unless an explicitly reviewed proxy endpoint is required.
CODEX_HUB_SERVER_AI_ALLOW_CUSTOM_BASE_URLS=0

# Outbound system email. Deployment gate stays closed until setup is complete.
# The owner must also verify a recipient and enable notifications in the Hub UI.
CODEX_HUB_EMAIL_ENABLED=0
CODEX_HUB_EMAIL_DOMAIN_VERIFIED=0
CODEX_HUB_EMAIL_FROM_ADDRESS="Hub <notify@notify.example.invalid>"
# CODEX_HUB_EMAIL_PUBLIC_BASE_URL=https://hub.example.com/hub
# CODEX_HUB_EMAIL_API_KEY=configure-through-a-secure-channel
# CODEX_HUB_EMAIL_WEBHOOK_SECRET=configure-through-a-secure-channel
# A non-default CODEX_HUB_SECRET_KEY is required for verification links.
CODEX_HUB_EMAIL_POLL_SECONDS=2
CODEX_HUB_EMAIL_TIMEOUT_SECONDS=20
CODEX_HUB_EMAIL_MAX_ATTEMPTS=6
CODEX_HUB_EMAIL_HOURLY_LIMIT=10
CODEX_HUB_EMAIL_DAILY_LIMIT=50
CODEX_HUB_EMAIL_RATE_INTERVAL_SECONDS=1

# Application mail API: each request supplies its own recipients.
# Separate switch; uses the verified sender and provider settings above.
CODEX_HUB_MAIL_API_ENABLED=0
CODEX_HUB_MAIL_API_HOURLY_LIMIT=30
CODEX_HUB_MAIL_API_DAILY_LIMIT=100
